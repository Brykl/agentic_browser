{
  "name": "agentic_browser",
  "version": "0.1.0",
  "description": "",
  "main": "dist/index.js",
  "scripts": {
    "dev": "node --watch ./api/src/index.ts",
    "dev:ui": "pnpm --filter ui dev",
    "start": "node ./dist/index.js",
    "build": "pnpm run build:api && pnpm run build:ui",
    "build:api": "tsc",
    "build:ui": "pnpm --filter ui build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:ui": "pnpm --filter ui lint",
    "fmt": "prettier --write .",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.18.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.18.0",
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@jest/globals": "30.5.2",
    "@types/node": "^24.19.2",
    "@types/ws": "^8.18.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.2"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.1.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "fastify": "^5.12.8",
    "puppeteer": "^25.17.0",
    "puppeteer-core": "^25.17.0",
    "ws": "^8.22.2",
    "zod": "^4.6.7"
  }
}
